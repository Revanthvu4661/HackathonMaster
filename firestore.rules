rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can read and write ONLY their own data under /users/{uid}/**
    // (the profile doc users/{uid} and all subcollections: history, strategies, checklists, meta).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed: no public read or write.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
